---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A travel blog for friends and family' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Travel Blog RSS" href="/rss.xml" />
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 text-stone-800 min-h-screen flex flex-col">
    <header class="bg-stone-900 text-white py-6">
      <div class="container mx-auto px-4 max-w-4xl">
        <nav class="flex justify-between items-center">
          <a href="/" class="text-2xl font-bold hover:text-stone-300 transition-colors">
            🌍 Travel Adventures
          </a>
          <div class="flex gap-6">
            <a href="/" class="hover:text-stone-300 transition-colors">Home</a>
            <a href="/blog" class="hover:text-stone-300 transition-colors">Blog</a>
            <a href="/gallery" class="hover:text-stone-300 transition-colors">Gallery</a>
            <a href="/rss.xml" class="hover:text-stone-300 transition-colors" title="RSS Feed">📡</a>
          </div>
        </nav>
      </div>
    </header>
    
    <main class="flex-1 container mx-auto px-4 py-8 max-w-4xl">
      <slot />
    </main>
    
    <footer class="bg-stone-200 py-6 mt-8">
      <div class="container mx-auto px-4 max-w-4xl text-center text-stone-600">
        <p>&copy; {new Date().getFullYear()} Travel Adventures. Made with ❤️ for friends and family.</p>
      </div>
    </footer>
  </body>
</html>
