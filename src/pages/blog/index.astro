---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog | Travel Adventures">
  <h1 class="text-4xl font-bold mb-8 text-stone-900">All Posts</h1>
  
  <div class="grid gap-6">
    {posts.map((post) => (
      <article class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow">
        <div class="flex items-center gap-2 text-sm text-stone-500 mb-2">
          <time>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          {post.data.location && (
            <>
              <span>•</span>
              <span>📍 {post.data.location}</span>
            </>
          )}
        </div>
        <h2 class="text-2xl font-semibold mb-2">
          <a href={`/blog/${post.id}`} class="text-stone-900 hover:text-amber-600 transition-colors">
            {post.data.title}
          </a>
        </h2>
        <p class="text-stone-600 mb-3">{post.data.description}</p>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="bg-stone-100 text-stone-700 px-3 py-1 rounded-full text-sm">
              {tag}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</Layout>
