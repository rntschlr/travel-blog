---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Travel Adventures">
  <section class="mb-12">
    <h1 class="text-5xl font-bold mb-4 text-stone-900">Welcome to My Travels</h1>
    <p class="text-xl text-stone-600 leading-relaxed">
      Hey everyone! This is where I'll be sharing my adventures while traveling the world. 
      No social media needed - just bookmark this page and check back for updates. 
      You can also subscribe to the RSS feed to get notified when I post new stories.
    </p>
  </section>

  <section>
    <h2 class="text-3xl font-semibold mb-6 text-stone-800">Latest Posts</h2>
    <div class="grid gap-8">
      {posts.map((post) => (
        <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
          {post.data.heroImage && (
            <img 
              src={post.data.heroImage} 
              alt={post.data.title}
              class="w-full h-48 object-cover"
            />
          )}
          <div class="p-6">
            <div class="flex items-center gap-2 text-sm text-stone-500 mb-2">
              <time>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
              {post.data.location && (
                <>
                  <span>•</span>
                  <span>📍 {post.data.location}</span>
                </>
              )}
            </div>
            <h3 class="text-2xl font-semibold mb-2">
              <a href={`/blog/${post.id}`} class="text-stone-900 hover:text-amber-600 transition-colors">
                {post.data.title}
              </a>
            </h3>
            <p class="text-stone-600 mb-4">{post.data.description}</p>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="bg-stone-100 text-stone-700 px-3 py-1 rounded-full text-sm">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
