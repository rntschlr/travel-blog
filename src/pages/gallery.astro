---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import { withBase } from '../lib/url';

const photos = (await getCollection('photos')).sort((a, b) => {
  const da = a.data.date?.valueOf() ?? 0;
  const db = b.data.date?.valueOf() ?? 0;
  return db - da;
});
---

<Layout title={`Photo Gallery | ${site.title}`}>
  <h1 class="text-4xl font-bold mb-4 text-stone-900">Photo Gallery</h1>
  <p class="text-stone-600 mb-8">A collection of moments from my travels.</p>

  {photos.length === 0 ? (
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
      <p class="text-5xl mb-4">📷</p>
      <p class="text-stone-600 text-lg">No photos yet — check back soon!</p>
    </div>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {photos.map((photo) => (
        <figure class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
          <img
            src={withBase(photo.data.image)}
            alt={photo.data.alt}
            loading="lazy"
            class="w-full h-48 object-cover"
          />
          <figcaption class="p-4">
            <p class="font-medium text-stone-800">{photo.data.caption ?? photo.data.alt}</p>
            {photo.data.location && (
              <p class="text-sm text-stone-500">📍 {photo.data.location}</p>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
  )}
</Layout>
