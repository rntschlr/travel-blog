---
import Layout from '../layouts/Layout.astro';

const galleryImages = [
  { src: '/images/kyoto-temple.jpg', alt: 'Kinkaku-ji Temple', location: 'Kyoto, Japan' },
  { src: '/images/cherry-blossoms.jpg', alt: 'Cherry Blossoms', location: 'Kyoto, Japan' },
  { src: '/images/ramen.jpg', alt: 'Delicious Ramen', location: 'Kyoto, Japan' },
  { src: '/images/bamboo-forest.jpg', alt: 'Bamboo Forest', location: 'Arashiyama, Japan' },
  { src: '/images/deer-park.jpg', alt: 'Friendly Deer', location: 'Nara, Japan' },
  { src: '/images/fushimi-inari.jpg', alt: 'Fushimi Inari Shrine', location: 'Kyoto, Japan' },
];
---

<Layout title="Photo Gallery | Travel Adventures">
  <h1 class="text-4xl font-bold mb-4 text-stone-900">Photo Gallery</h1>
  <p class="text-stone-600 mb-8">A collection of moments from my travels.</p>
  
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {galleryImages.map((image) => (
      <figure class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
        <img 
          src={image.src} 
          alt={image.alt}
          class="w-full h-48 object-cover"
        />
        <figcaption class="p-4">
          <p class="font-medium text-stone-800">{image.alt}</p>
          <p class="text-sm text-stone-500">📍 {image.location}</p>
        </figcaption>
      </figure>
    ))}
  </div>
  
  <p class="mt-8 text-stone-500 text-center">More photos coming soon as I continue my journey!</p>
</Layout>
