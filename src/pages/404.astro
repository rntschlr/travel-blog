---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import { withBase } from '../lib/url';
---

<Layout title={`Page not found | ${site.title}`}>
  <div class="text-center py-16">
    <p class="text-6xl mb-4">🧭</p>
    <h1 class="text-4xl font-bold text-stone-900 mb-4">Page not found</h1>
    <p class="text-stone-600 mb-8">Looks like this page wandered off the map.</p>
    <a href={withBase('/')} class="text-amber-700 hover:text-amber-800 underline">← Back to the homepage</a>
  </div>
</Layout>
